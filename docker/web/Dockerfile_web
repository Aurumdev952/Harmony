# syntax=docker/dockerfile:1.27.1@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e
ARG NAMESPACE=ghcr.io/zenysis
ARG IMAGE_PREFIX=harmony
ARG TAG=latest

FROM ${NAMESPACE}/${IMAGE_PREFIX}-web-client:${TAG} AS client-build
FROM ${NAMESPACE}/${IMAGE_PREFIX}-web-server:${TAG} AS server-build

# One image for web and worker: the server image (CPython 3.13, uv.lock) plus the
# built client and the container scripts.
FROM server-build

# Redeclare the TAG arg since ARGs before FROM are outside of a build stage and
# can't be reused after FROM.
# https://docs.docker.com/engine/reference/builder/#understand-how-arg-and-from-interact
ARG TAG

ENV INSTALL_PATH=/zenysis
ENV ZEN_HOME=${INSTALL_PATH} \
  R77_SRC_ROOT=${INSTALL_PATH} \
  ZENYSIS_SRC_ROOT=${INSTALL_PATH} \
  PYTHONPATH=${INSTALL_PATH} \
  PYTHONUNBUFFERED=1 \
  BUILD_TAG=${TAG} \
  ZEN_PROD=1

WORKDIR ${INSTALL_PATH}

# What the app user writes: static files and logs under /data/output, and uploads.
RUN mkdir -p web/public /data/output uploads && \
  chown zenysis:zenysis /data/output uploads

# Compose mounts the MinIO client config read-only at a root-owned path; the app
# reads ~/.mc/config.json through this root-owned symlink.
RUN mkdir -p /etc/zenysis/mc && ln -s /etc/zenysis/mc /home/zenysis/.mc

# Copy the built client files.
COPY --from=client-build /client/ web/public/

# Copy over various utilities.
COPY docker/entrypoint_web.sh docker/entrypoint_web.sh
COPY docker/web/run_as_zenysis.sh /usr/local/bin/run_as_zenysis
COPY docker/web/hand_over_data.sh /usr/local/bin/hand_over_data
COPY scripts scripts

# Copy all utilities used by the docker web container to the source root.
COPY docker/web/scripts/* ./

# Web server runs on port 5000.
EXPOSE 5000

# The app never runs as root. Root-owned data from older images is handed over
# by the one-shot data-owner service (docker/web/hand_over_data.sh).
ENV HOME=/home/zenysis USER=zenysis
USER 1000:1000
ENTRYPOINT ["run_as_zenysis"]
CMD ["./docker/entrypoint_web.sh"]
