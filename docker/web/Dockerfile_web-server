# Python dependencies, built from uv.lock: the shared dependencies plus the `web` group.
FROM python:3.13.16-slim-bookworm@sha256:5024f48ba9441d4b13a95d3945abc6365538e3a31109833367a1923523c6efed AS build

COPY --from=ghcr.io/astral-sh/uv:0.12.23@sha256:61d393e44e249f2e4b526b6c7ddcecce245946826e608e11c93ad4f5bba55b21 /uv /bin/uv

# git fetches the two git dependencies (Flask-Potion, pylib); gcc builds the C
# speedups of the sdists that have them (MarkupSafe, SQLAlchemy).
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,target=/var/lib/apt,sharing=locked \
  rm -f /etc/apt/apt.conf.d/docker-clean && \
  apt-get update && \
  apt-get install --no-install-recommends -y git gcc libc6-dev

ENV UV_COMPILE_BYTECODE=1 \
  UV_LINK_MODE=copy \
  UV_PYTHON_DOWNLOADS=0 \
  UV_PROJECT_ENVIRONMENT=/zenysis/.venv

WORKDIR /zenysis
RUN --mount=type=cache,target=/root/.cache/uv \
  --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
  --mount=type=bind,source=uv.lock,target=uv.lock \
  uv sync --locked --no-install-project --no-default-groups --group web


FROM python:3.13.16-slim-bookworm@sha256:5024f48ba9441d4b13a95d3945abc6365538e3a31109833367a1923523c6efed

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,target=/var/lib/apt,sharing=locked \
  rm -f /etc/apt/apt.conf.d/docker-clean && \
  apt-get update && \
  apt-get install --no-install-recommends -y lz4

# The web and worker processes run as this user (USER in Dockerfile_web). Its
# uid matches the host user that owns the deployments' data directories.
RUN groupadd --gid 1000 zenysis && \
  useradd --uid 1000 --gid zenysis --create-home --shell /bin/bash zenysis

ENV INSTALL_PATH=/zenysis \
  PATH=/zenysis/.venv/bin:$PATH
WORKDIR ${INSTALL_PATH}

COPY --link --from=build /zenysis/.venv .venv

# Python code, owned by root and read-only to the app user.
COPY config config
COPY harmony harmony
COPY data data
COPY db db
COPY log log
COPY models models
COPY graphql graphql
COPY util util
COPY web/*.py web/
COPY web/server web/server
RUN python -m compileall -q -j 0 config data db harmony log models graphql util web
