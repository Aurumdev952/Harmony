+def _column_names(cursor, query: str, table_ident: str) -> list[str]:
+    cursor.execute(query, (table_ident,))
+    return [row[0] for row in cursor.fetchall()]
+
+
+def _primary_key(cursor, table_ident: str) -> list[str]:
+    key = _column_names(
+        cursor,
+        'SELECT a.attname FROM pg_index i JOIN pg_attribute a'
+        ' ON a.attrelid = i.indrelid AND a.attnum = ANY(i.indkey)'
+        ' WHERE i.indrelid = %s::regclass AND i.indisprimary ORDER BY a.attnum',
+        table_ident,
+    )
+    if not key:
+        raise ImportTableDataError(f'Table {table_ident} has no primary key.')
+    return key
+
+
+def _delete_rows_missing_from_staging(cursor, table_ident: str, staging_ident: str):
+    '''Deletes the rows the export does not carry. A table that no foreign key
+    references is emptied instead, so that a mapping row whose id holds a different
+    pair in the export cannot collide with the table's other unique constraints.'''
+    cursor.execute(
+        'SELECT EXISTS (SELECT 1 FROM pg_constraint'
+        " WHERE contype = 'f' AND confrelid = %s::regclass)",
+        (table_ident,),
+    )
+    if not cursor.fetchone()[0]:
+        cursor.execute(sql.SQL('DELETE FROM {}').format(sql.SQL(table_ident)))
+        return
+    cursor.execute(
+        sql.SQL(
+            'DELETE FROM {table} AS t WHERE NOT EXISTS'
+            ' (SELECT 1 FROM {staging} AS s WHERE {match})'
+        ).format(
+            table=sql.SQL(table_ident),
+            staging=sql.SQL(staging_ident),
+            match=sql.SQL(' AND ').join(
+                sql.SQL('s.{0} = t.{0}').format(sql.Identifier(column))
+                for column in _primary_key(cursor, table_ident)
+            ),
+        )
+    )
+
+
+def _upsert_rows_from_staging(cursor, table_ident: str, staging_ident: str):
+    '''Inserts the staged rows, updating in place the rows whose primary key the
+    table already holds.'''
+    columns = _column_names(
+        cursor,
+        'SELECT attname FROM pg_attribute WHERE attrelid = %s::regclass'
+        ' AND attnum > 0 AND NOT attisdropped ORDER BY attnum',
+        table_ident,
+    )
+    key = _primary_key(cursor, table_ident)
+    updates = [column for column in columns if column not in key]
+    on_conflict = (
+        sql.SQL('DO UPDATE SET {}').format(
+            sql.SQL(', ').join(
+                sql.SQL('{0} = EXCLUDED.{0}').format(sql.Identifier(column))
+                for column in updates
+            )
+        )
+        if updates
+        else sql.SQL('DO NOTHING')
+    )
+    cursor.execute(
+        sql.SQL(
+            'INSERT INTO {table} ({columns}) SELECT {columns} FROM {staging}'
+            ' ON CONFLICT ({key}) {on_conflict}'
+        ).format(
+            table=sql.SQL(table_ident),
+            staging=sql.SQL(staging_ident),
+            columns=sql.SQL(', ').join(map(sql.Identifier, columns)),
+            key=sql.SQL(', ').join(map(sql.Identifier, key)),
+            on_conflict=on_conflict,
+        )
+    )
+
+
