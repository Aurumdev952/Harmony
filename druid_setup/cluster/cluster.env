DRUID_MASTER_HOST=xxx.xxx.xxx.xxx
DRUID_DATA_HOST=xxx.xxx.xxx.xxx
DRUID_QUERY_HOST=xxx.xxx.xxx.xxx

# Druid postgres connection details
DRUID_POSTGRES_HOST=xxx.xxx.xxx.xxx
# DRUID_POSTGRES_PASSWORD is required and has no default. Set it in
# druid_setup/.env, which the Makefile exports, not in this file.
DRUID_POSTGRES_USER=druid
DRUID_POSTGRES_DB=druid

# Druid zookeeper details
DRUID_ZOOKEEPER_HOST=xxx.xxx.xxx.xxx
