# Settings every audit mode shares. Semantics-bearing settings live in the mode
# files; caching is off so every answer comes from the segments.
DRUID_XMX=768m
DRUID_XMS=768m
DRUID_MAXNEWSIZE=128m
DRUID_NEWSIZE=128m
DRUID_MAXDIRECTMEMORYSIZE=1g

druid_zk_service_host=zookeeper
druid_metadata_storage_type=postgresql
druid_metadata_storage_connector_connectURI=jdbc:postgresql://postgres:5432/druid
druid_metadata_storage_connector_user=druid
druid_metadata_storage_connector_password={"type": "environment", "variable": "AUDIT_PG_PASSWORD"}

druid_storage_type=local
druid_storage_storageDirectory=/druid-deep/segments
druid_indexer_logs_type=file
druid_indexer_logs_directory=/druid-deep/indexing-logs

druid_coordinator_asOverlord_enabled=true
druid_coordinator_asOverlord_overlordService=druid/overlord
druid_coordinator_period=PT5S
druid_coordinator_startDelay=PT5S
druid_manager_segments_pollDuration=PT5S
druid_indexer_runner_type=httpRemote
druid_indexer_storage_type=metadata
druid_worker_capacity=2
druid_indexer_runner_javaOptsArray=["-server", "-Xmx768m", "-Xms768m", "-XX:MaxDirectMemorySize=1g", "-Duser.timezone=UTC", "-Dfile.encoding=UTF-8"]
druid_indexer_fork_property_druid_processing_buffer_sizeBytes=100000000
druid_indexer_fork_property_druid_processing_numThreads=1

druid_processing_buffer_sizeBytes=100000000
druid_processing_numThreads=2
druid_processing_numMergeBuffers=2
druid_segmentCache_locations=[{"path": "/opt/druid/var/segment-cache", "maxSize": 10000000000}]
druid_server_maxSize=10000000000
druid_broker_cache_useCache=false
druid_broker_cache_populateCache=false
druid_historical_cache_useCache=false
druid_historical_cache_populateCache=false
druid_sql_enable=true
