# Druid 38.0.0 with the only null semantics it has (SQL-compatible nulls, strict
# booleans, three-valued native filters; the legacy flags were removed in 32 and
# must not be set). JavaScript off, as SEC-8 requires. The Zenysis extensions
# exist for 0.23 only, so aggregateLast queries fail here by design.
druid_extensions_loadList=["druid-datasketches", "druid-stats", "druid-lookups-cached-global", "postgresql-metadata-storage"]
druid_javascript_enabled=false
