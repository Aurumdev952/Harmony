# Druid 0.23 as druid_setup runs it today: legacy nulls, JavaScript on. The
# null and boolean flags are spelled out so the baseline does not rest on
# defaults (both are the 0.23 defaults).
druid_extensions_loadList=["druid-datasketches", "druid-stats", "druid-lookups-cached-global", "postgresql-metadata-storage", "/opt/zen-extensions/druid-aggregatable-first-last"]
druid_generic_useDefaultValueForNull=true
druid_expressions_useStrictBooleans=false
druid_javascript_enabled=true
