# Druid 0.23 with SQL-compatible nulls: the audit configuration SPEC 8a names.
# 0.23 still evaluates native filters with two-valued logic (three-valued logic
# arrived in 28), so `not` over null rows is only representative on druid38.
druid_extensions_loadList=["druid-datasketches", "druid-stats", "druid-lookups-cached-global", "postgresql-metadata-storage", "/opt/zen-extensions/druid-aggregatable-first-last"]
druid_generic_useDefaultValueForNull=false
druid_expressions_useStrictBooleans=false
druid_javascript_enabled=true
