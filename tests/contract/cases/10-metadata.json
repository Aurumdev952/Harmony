    {
      "id": "configuration.list",
      "route": "GET /api2/configuration",
      "pin": [
        "/[]/key"
      ]
    },
    {
      "id": "configuration.get",
      "route": "GET /api2/configuration/<key>",
      "path": "/api2/configuration/default_url",
      "pin": [
        "/key",
        "/defaultValue"
      ]
    },
    {
      "id": "configuration.set",
      "route": "POST /api2/configuration/<key>/set",
      "path": "/api2/configuration/default_url/set",
      "body": "/overview",
      "pin": [
        "/value"
      ],
      "note": "Sets the key to its default, so the run leaves no trace."
    },
    {
      "id": "configuration.reset",
      "route": "POST /api2/configuration/<key>/reset",
      "path": "/api2/configuration/default_url/reset",
      "body": {},
      "pin": [
        "/value"
      ]
    },
    {
      "id": "authorization.check",
      "route": "POST /api/authorization",
      "pin": [
        "/success"
      ],
      "body": {
        "permission": "view_query_form",
        "resourceType": "SITE",
        "resourceName": null
      }
    },
    {
      "id": "authorization.check_multi",
      "route": "POST /api/authorization_multi",
      "pin": [
        "/0/authorized",
        "/1/authorized"
      ],
      "body": [
        {
          "permission": "view_query_form",
          "resourceType": "SITE",
          "resourceName": null
        },
        {
          "permission": "create_resource",
          "resourceType": "DASHBOARD",
          "resourceName": null
        }
      ]
    },
    {
