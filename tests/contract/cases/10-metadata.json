{
  "cases": [
    {
      "id": "pipeline_run_metadata.seed.all_sources",
      "route": "POST /api2/pipeline_run_metadata",
      "body": {
        "source": "ALL_SOURCES",
        "digestMetadata": {
          "data_points_count": 120,
          "start_date": "2020-01-01",
          "end_date": "2020-12-31",
          "fields_count": 1,
          "start_ts": "2020-12-31T00:00:00",
          "next_run": "2021-01-07T00:00:00",
          "failed": false
        },
        "generationDatetime": {
          "$date": 1704067200000
        }
      },
      "capture": {
        "pipeline_run_all_sources": "/$uri"
      },
      "note": "The pipeline writes these rows; no client does. Seeded so digest and pipeline queries return items. next_run, start_ts and failed are what populate_pipeline_run_metadata.py writes for a scheduled run; usePipelineTimesLastPipelineQuery reads next_run."
    },
    {
      "id": "pipeline_run_metadata.seed.yellow_fever",
      "route": "POST /api2/pipeline_run_metadata",
      "body": {
        "source": "yellow_fever",
        "digestMetadata": {
          "data_points_count": 120,
          "start_date": "2020-01-01",
          "end_date": "2020-12-31",
          "fields_count": 1,
          "start_ts": "2020-12-31T00:00:00"
        },
        "generationDatetime": {
          "$date": 1704067200000
        }
      },
      "capture": {
        "pipeline_run_yellow_fever": "/$uri"
      },
      "note": "The pipeline writes these rows; no client does. Seeded so digest and pipeline queries return items."
    },
